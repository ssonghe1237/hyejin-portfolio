### 05. 신규 기술스택 추가
# projectTechId가 null이면 신규 등록
PUT {{baseUrl}}/api/admin/projects/{{projectId}}
Content-Type: application/json
Accept: application/json

{
  "title": "포트폴리오 사이트",
  "slug": "portfolio-site",
  "summary": "Spring Boot 기반 포트폴리오 사이트",
  "description": "관리자 프로젝트 등록 및 수정 기능을 제공합니다.",
  "projectType": "PERSONAL",
  "startDate": "2026-06-25",
  "endDate": null,
  "teamName": null,
  "role": "Full Stack",
  "displayOrder": 0,
  "published": true,

  "thumbnailImage": null,
  "heroImages": [],
  "deletedImageIds": [],

  "sections": [],
  "deletedSectionIds": [],

  "techStacks": [
    {
      "projectTechId": null,
      "techName": "TEST_TECH",
      "techCategory": "TEST",
      "displayOrder": 99
    }
  ],
  "deletedTechIds": [],

  "links": [],
  "deletedLinkIds": []
}


### 06. 신규 기술스택 등록 결과 확인
GET {{baseUrl}}/api/admin/projects/{{projectId}}
Accept: application/json


