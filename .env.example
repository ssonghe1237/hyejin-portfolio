# ============================================================
# Portfolio Docker Environment Example
#
# 실제 실행 시:
#
# cp .env.example .env
#
# 이후 .env의 비밀번호를 실제 값으로 수정한다.
#
# .env는 Git에 올리면 안 된다.
# ============================================================


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_DB=portfolio_db

# Local의 postgres superuser를 그대로 쓰기보다
# Production 전용 계정을 별도로 사용하는 방향
POSTGRES_USER=portfolio

# 실제 .env에서는 반드시 강한 비밀번호로 변경
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD


# ------------------------------------------------------------
# Frontend Host Port
# ------------------------------------------------------------

# Local Docker 테스트
#
# http://localhost:8080
FRONTEND_PORT=8080


# ------------------------------------------------------------
# Upload Host Directory
# ------------------------------------------------------------

# docker-compose.yml 기준 상대 경로
#
# 현재 프로젝트의:
# ./uploads
#
# 를 Backend Container의
# /app/uploads
#
# 로 연결한다.
UPLOADS_HOST_PATH=./uploads